        function getLevenshteinDistance(a, b) {
            const matrix = Array.from({ length: a.length + 1 }, () => Array(b.length + 1).fill(0));
            for (let i = 0; i <= a.length; i++) matrix[i][0] = i;
            for (let j = 0; j <= b.length; j++) matrix[0][j] = j;

            for (let i = 1; i <= a.length; i++) {
                for (let j = 1; j <= b.length; j++) {
                    const cost = a[i - 1] === b[j - 1] ? 0 : 1;
                    matrix[i][j] = Math.min(
                        matrix[i - 1][j] + 1,
                        matrix[i][j - 1] + 1,
                        matrix[i - 1][j - 1] + cost
                    );
                }
            }
            return matrix[a.length][b.length];
        }

        function shuffleArray(arr) {
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        }

        function handleImgError(img, folder, filename) {
            const encFolder = encodeURIComponent(folder);
            const encFile = encodeURIComponent(filename);

            const paths = [
                `Images/Reg 1/${folder}/${filename}`,
                `Images/Reg 1/${encFolder}/${encFile}`,
                `Images/${folder}/${filename}`,
                `Images/${encFolder}/${encFile}`,
                `./Images/Reg 1/${encFolder}/${encFile}`,
                `../Images/Reg 1/${encFolder}/${encFile}`,
                `images/Reg 1/${encFolder}/${encFile}`
            ];

            let attempt = parseInt(img.getAttribute('data-attempt') || '0', 10);
            if (attempt < paths.length) {
                img.setAttribute('data-attempt', (attempt + 1).toString());
                img.src = paths[attempt];
            } else {
                img.style.display = 'none';
                const wrapper = img.parentElement;
                wrapper.innerHTML = `
                    <div class="img-fallback-alert">
                        <strong>Tagged Structure:</strong> <code>${filename}</code><br>
                        Location: <code>Images/Reg 1/${folder}/</code>
                    </div>
                `;
            }
        }

