                    "Pronator Quadratus": "Incorrect. Deep transverse muscle in the distal forearm.",
                    "Flexor Carpi Radialis": "Incorrect. Passes to the base of the 2nd metacarpal.",
                    "Brachioradialis": "Incorrect. Lateral compartment muscle inserting on the radial styloid."
                }
            },
            {
                compartment: "Forearm Flexors",
                folder: "Week 3",
                filename: "Flexor Carpi Radialis.PNG",
                prompt: "Identify the highlighted tendon that travels through a groove in the trapezium to insert on the second metacarpal base:",
                canonical: "Flexor Carpi Radialis",
