        function renderQuestions() {
            const container = document.getElementById('quiz-container');
            container.innerHTML = '';

            activePool.forEach((item, index) => {
                const card = document.createElement('div');
                card.className = 'question-card';
                card.id = `card-${index}`;

                if (!item.shuffledOptions) {
                    const opts = [item.canonical, ...item.distractors];
                    shuffleArray(opts);
                    item.shuffledOptions = opts;
                }

                const meta = document.createElement('div');
                meta.className = 'card-meta';
                meta.innerHTML = `<span>Item ${index + 1} of ${activePool.length}</span><span>${item.compartment}</span>`;
                card.appendChild(meta);

                const imgWrap = document.createElement('div');
                imgWrap.className = 'image-wrapper';
                const img = document.createElement('img');
                img.alt = item.canonical;
                img.setAttribute('data-attempt', '0');
                img.onerror = () => handleImgError(img, item.folder, item.filename);
                img.src = `Images/Reg 1/${item.folder}/${item.filename}`;
                imgWrap.appendChild(img);
                card.appendChild(imgWrap);

                const prompt = document.createElement('div');
                prompt.className = 'question-prompt';
                prompt.innerText = item.prompt;
                card.appendChild(prompt);

                if (currentMode === 'mcq') {
                    const optContainer = document.createElement('div');
                    optContainer.className = 'options-container';

                    item.shuffledOptions.forEach((optText, oIdx) => {
                        const letter = String.fromCharCode(65 + oIdx);
                        const btn = document.createElement('button');
                        btn.className = 'option-btn';
                        btn.id = `btn-${index}-${oIdx}`;
                        btn.innerText = `${letter}) ${optText}`;
                        btn.onclick = () => submitMCQ(index, optText, oIdx);
                        optContainer.appendChild(btn);
                    });
                    card.appendChild(optContainer);
                } else {
                    const typeBox = document.createElement('div');
                    typeBox.className = 'typein-box';
                    typeBox.innerHTML = `
                        <input type="text" class="typein-input" id="input-${index}" placeholder="Type anatomical structure..." autocomplete="off" spellcheck="false" onkeydown="handleEnter(event, ${index})">
                        <button class="typein-btn" id="btn-submit-${index}" onclick="submitTypeIn(${index})">Check</button>
                    `;
                    card.appendChild(typeBox);
                }

                const expDiv = document.createElement('div');
                expDiv.className = 'explanation';
                expDiv.id = `exp-${index}`;
                card.appendChild(expDiv);

                container.appendChild(card);
            });
        }

        function handleEnter(e, qIdx) {
            if (e.key === 'Enter') {
                submitTypeIn(qIdx);
            }
        }

        function submitMCQ(qIdx, selectedText, oIdx) {
            if (userResponses[qIdx]) return;

            const item = activePool[qIdx];
            const isCorrect = (selectedText === item.canonical);
            userResponses[qIdx] = { correct: isCorrect, answer: selectedText };

            const card = document.getElementById(`card-${qIdx}`);
            const buttons = card.querySelectorAll('.option-btn');
            buttons.forEach(btn => btn.disabled = true);

            const selectedBtn = document.getElementById(`btn-${qIdx}-${oIdx}`);
            if (isCorrect) {
                selectedBtn.classList.add('correct');
            } else {
                selectedBtn.classList.add('incorrect');
                buttons.forEach(btn => {
                    if (btn.innerText.includes(item.canonical)) {
                        btn.classList.add('correct');
                    }
                });
            }

            renderExplanation(qIdx, isCorrect, null);
            updateScore();
        }

        function submitTypeIn(qIdx) {
            if (userResponses[qIdx]) return;

            const item = activePool[qIdx];
            const inputEl = document.getElementById(`input-${qIdx}`);
            const submitBtn = document.getElementById(`btn-submit-${qIdx}`);
            const rawVal = inputEl.value.trim().toLowerCase();

            if (!rawVal) return;

            inputEl.disabled = true;
            submitBtn.disabled = true;

            let isCorrect = false;
            let matchedSynonym = null;
            let isTypo = false;

            for (let syn of item.synonyms) {
                const target = syn.toLowerCase();
                if (rawVal === target) {
                    isCorrect = true;
                    matchedSynonym = syn;
                    break;
                }
                const dist = getLevenshteinDistance(rawVal, target);
                if (target.length > 7 && dist <= 2) {
                    isCorrect = true;
                    matchedSynonym = syn;
                    isTypo = true;
                    break;
                }
            }

            userResponses[qIdx] = { correct: isCorrect, answer: inputEl.value };

            if (isCorrect) {
                inputEl.style.borderColor = "var(--correct-border)";
                inputEl.style.backgroundColor = "var(--correct-bg)";
            } else {
                inputEl.style.borderColor = "var(--incorrect-border)";
                inputEl.style.backgroundColor = "var(--incorrect-bg)";
            }

            renderExplanation(qIdx, isCorrect, isTypo ? matchedSynonym : null);
            updateScore();
        }

        function renderExplanation(qIdx, isCorrect, typoTarget) {
            const item = activePool[qIdx];
            const expDiv = document.getElementById(`exp-${qIdx}`);
            const statusClass = isCorrect ? 'correct' : 'incorrect';
            const statusText = isCorrect ? 'Correct!' : 'Incorrect.';

            let rationalesHTML = '';
            item.shuffledOptions.forEach((optText, idx) => {
                const letter = String.fromCharCode(65 + idx);
                const expl = item.rationales[optText] || (optText === item.canonical ? "Correct anatomical identification." : "Incorrect distractor.");
                rationalesHTML += `
                    <li class="rationale-item">
                        <strong>${letter}) ${optText}</strong>: ${expl}
                    </li>
                `;
            });

            let typoNote = typoTarget ? `<div class="fuzzy-note">Spelling accepted: matched "${typoTarget}"</div>` : '';

            expDiv.innerHTML = `
                <div class="status-banner ${statusClass}">${statusText}</div>
                ${typoNote}
                <div class="explanation-summary"><strong>Concept Explanation:</strong> ${item.concept}</div>
                <ul class="rationale-list">
                    ${rationalesHTML}
                </ul>
            `;
            expDiv.style.display = 'block';
        }

        function updateScore() {
            const answeredCount = Object.keys(userResponses).length;
            const correctCount = Object.values(userResponses).filter(r => r.correct).length;
            const total = activePool.length;
            const pct = total === 0 ? 0 : Math.round((correctCount / total) * 100);

            document.getElementById('score-header').innerText = `Score: ${correctCount} / ${total} (${pct}%)`;

            if (answeredCount === total && total > 0) {
                showSummary(correctCount, total, pct);
            }
        }

        function showSummary(correct, total, pct) {
            const summaryCard = document.getElementById('summary-card');
            const scoreDisplay = document.getElementById('final-score-display');
            const feedback = document.getElementById('summary-feedback');

            scoreDisplay.innerText = `${correct} / ${total} (${pct}%)`;

            if (pct >= 90) {
                feedback.innerText = "Mastery Level Demonstrated! Exceptional identification across the carpal tunnel, thenar, hypothenar, and intrinsic hand compartments.";
            } else if (pct >= 75) {
                feedback.innerText = "Strong passing performance. Review the lumbrical origin details and interosseous mechanics before your practical exam.";
            } else {
                feedback.innerText = "Re-test recommended. Re-study the OAF arrangements, Guyon's canal boundaries, and palmar arches.";
            }

            summaryCard.style.display = 'block';
            summaryCard.scrollIntoView({ behavior: 'smooth' });
        }

        function resetQuiz() {
            initPool();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        window.onload = () => {
            initPool();
        };
    </script>
</body>
