let currentFilterWeek = "all";
let currentFilterSubject = "all";
let currentFilterDiff = "all";
let singleView = false;
let currentIndex = 0;
let userAnswers = {}; // id -> selected option index

const subjectSelect = document.getElementById("subjectFilter");
SUBJECTS.forEach((s, idx) => {
  const opt = document.createElement("option");
  opt.value = idx;
  opt.textContent = s;
  subjectSelect.appendChild(opt);
});

function getFilteredQuestions() {
  return questionBank.filter(q => {
    if (currentFilterWeek !== "all" && String(q.week) !== currentFilterWeek) return false;
    if (currentFilterSubject !== "all" && String(q.subjectIndex) !== currentFilterSubject) return false;
    if (currentFilterDiff !== "all" && q.difficulty !== currentFilterDiff) return false;
    return true;
  });
}

function updateScore() {
  const filtered = getFilteredQuestions();
  let answered = 0;
  let correct = 0;
  filtered.forEach(q => {
    if (userAnswers[q.id] !== undefined) {
      answered++;
      if (q.options[userAnswers[q.id]].correct) correct++;
    }
  });
  const pct = answered > 0 ? Math.round((correct / answered) * 100) : 0;
  document.getElementById("scorePill").textContent = `Score: ${correct} / ${filtered.length} (${pct}% answered accuracy)`;
}

function render() {
  const container = document.getElementById("quizContainer");
  container.innerHTML = "";
  const list = getFilteredQuestions();
  updateScore();

  if (list.length === 0) {
    container.innerHTML = `<div class="summary-panel"><h3>No questions match your current filters.</h3></div>`;
    return;
  }

  if (currentIndex >= list.length) currentIndex = 0;
  const toRender = singleView ? [list[currentIndex]] : list;

  toRender.forEach((q, renderIdx) => {
    const displayNum = singleView ? currentIndex + 1 : renderIdx + 1;
    const card = document.createElement("div");
    card.className = "q-card";

    const chosen = userAnswers[q.id];
    const isAnswered = chosen !== undefined;

    let optionsHtml = "";
    const keys = ["A", "B", "C", "D"];
    q.options.forEach((opt, idx) => {
      let cls = "opt-btn";
      if (isAnswered) {
        if (opt.correct) cls += " correct";
        else if (idx === chosen) cls += " incorrect";
      }
      optionsHtml += `
        <button class="${cls}" ${isAnswered ? "disabled" : ""} onclick="selectOption(${q.id}, ${idx})">
          <span class="opt-key">${keys[idx]}.</span>
          <span>${opt.text}</span>
        </button>
      `;
    });

    let rationaleHtml = "";
    if (isAnswered) {
      rationaleHtml = `<div class="rationale-box">` +
        q.options.map((opt, idx) => `
          <div class="rationale-item ${opt.correct ? "is-right" : "is-wrong"}">
            <strong>${keys[idx]} (${opt.correct ? "Correct" : "Incorrect"}):</strong> ${opt.why}
          </div>
        `).join("") +
      `</div>`;
    }

    let navHtml = "";
    if (singleView) {
      navHtml = `
        <div class="nav-row">
          <button onclick="prevQ()" ${currentIndex === 0 ? "disabled" : ""}>← Previous</button>
          <span style="color:var(--muted);font-size:0.85rem;">Question ${displayNum} of ${list.length}</span>
          <button onclick="nextQ()" ${currentIndex === list.length - 1 ? "disabled" : ""}>Next →</button>
        </div>
      `;
    }

    card.innerHTML = `
      <div class="q-meta">
        <span class="badge week">Week ${q.week}</span>
        <span class="badge">${SUBJECTS[q.subjectIndex]}</span>
        <span class="badge">Difficulty: ${q.difficulty.toUpperCase()}</span>
        ${q.priority ? `<span class="badge priority">★ High-Yield Board</span>` : ""}
      </div>
      <div class="q-stem">${displayNum}. ${q.stem}</div>
      <div class="options-list">${optionsHtml}</div>
      ${rationaleHtml}
      ${navHtml}
    `;
    container.appendChild(card);
  });
}

window.selectOption = function(qId, optIdx) {
  if (userAnswers[qId] !== undefined) return;
  userAnswers[qId] = optIdx;
  render();
};

window.prevQ = function() {
  if (currentIndex > 0) {
    currentIndex--;
    render();
  }
};

window.nextQ = function() {
  const list = getFilteredQuestions();
  if (currentIndex < list.length - 1) {
    currentIndex++;
    render();
  }
};

document.getElementById("weekFilter").addEventListener("change", e => {
  currentFilterWeek = e.target.value;
  currentIndex = 0;
  render();
});

document.getElementById("subjectFilter").addEventListener("change", e => {
  currentFilterSubject = e.target.value;
  currentIndex = 0;
  render();
});

document.getElementById("diffFilter").addEventListener("change", e => {
  currentFilterDiff = e.target.value;
  currentIndex = 0;
  render();
});

document.getElementById("viewToggle").addEventListener("click", e => {
  singleView = !singleView;
  e.target.textContent = singleView ? "View: One by One" : "View: All at Once";
  render();
});

document.getElementById("shuffleBtn").addEventListener("click", () => {
  for (let i = questionBank.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [questionBank[i], questionBank[j]] = [questionBank[j], questionBank[i]];
  }
  currentIndex = 0;
  render();
});

document.getElementById("resetBtn").addEventListener("click", () => {
  userAnswers = {};
  currentIndex = 0;
  render();
});

render();
</script>
